# Google Gemini API Configuration
# Optional - the app works completely offline without it using rule-based fallback
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Specify whichever Gemini model your API key supports:
GEMINI_MODEL=your_gemini_model_here

# PostgreSQL Database Configuration
# Optional - required for telemetry logging to PostgreSQL (falls back to local JSON logs if unconfigured)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=istvon_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Alternatively set full connection string:
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/istvon_db
