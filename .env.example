# LLM configuration (optional). Without a usable key + model the app runs in a basic
# offline mode (regex pattern extraction + domain templates, no response generation).
# A key without its model is ignored. Gemini is used if configured, otherwise Groq.
# LLM_PROVIDER=gemini|groq forces one; if the forced one is incomplete the app runs
# offline (it does not fall back to the other) and the UI says what is missing.
# Prompts are sent to the provider as typed, including NEEDS_FIX ones.

# Google Gemini - key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Specify whichever Gemini model your API key supports:
GEMINI_MODEL=your_gemini_model_here

# Groq - key from https://console.groq.com/keys
# Called through Groq's OpenAI-compatible chat-completions API with Python's stdlib
# (urllib); no extra package. Tested with openai/gpt-oss-120b.
GROQ_API_KEY=your_groq_api_key_here
# Any chat model your key can use that supports JSON mode, e.g. openai/gpt-oss-120b
GROQ_MODEL=your_groq_model_here

# LLM_PROVIDER=groq

# PostgreSQL Database Configuration
# Optional - audit log in PostgreSQL (local JSON logs are written either way).
# If the server can't be reached, the app keeps working and retries at most once a minute.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=istvon_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Alternatively set full connection string:
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/istvon_db
